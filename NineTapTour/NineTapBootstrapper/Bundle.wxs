<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
	<Bundle Name="NineTapBootstrapper" Version="1.7.6" Manufacturer="Clover Park Technical College - Computer Programming" UpgradeCode="84f76d84-5c1c-457c-bf76-d6e1caae5bd9">
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication LicenseFile="License.rtf" LogoFile="Icon\9Tap.ico" />
    </BootstrapperApplicationRef>

    <!-- Bootstrapper help https://www.firegiant.com/wix/tutorial/net-and-net/bootstrapping/ -->
    
    <!-- Condition Variables: Check if .NET is installed-->
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full" Value="Version" Variable="Net4FullVersion" />
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Net Framework Setup\NDP\v4\Full" Value="Version" Variable="Net4x64FullVersion" Win64="yes" />
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL" Value="SQLExpress" Variable="SQL2014Expressx64" Win64="yes"/>
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL" Value="SQLExpress" Variable="SQL2014Expressx86"/>
    
		<Chain>
      <!-- Define the list of chained packages. -->
      <!-- .NET Framework-->
      <ExePackage Id="Net45" Name="Microsoft .NET Framework 4.5.2 Setup" Cache="no" Compressed="no" PerMachine="yes" Permanent="yes" Vital="yes" InstallCommand="/q"
        DownloadUrl="https://download.microsoft.com/download/E/2/1/E21644B5-2DF2-47C2-91BD-63C560427900/NDP452-KB2901907-x86-x64-AllOS-ENU.exe"
        DetectCondition="(Net4FullVersion = &quot;4.5.51209&quot;) AND (NOT VersionNT64 OR (Net4x64FullVersion = &quot;4.5.51209&quot;))"
        InstallCondition="(VersionNT >= v6.0 OR VersionNT64 >= v6.0) AND (NOT (Net4FullVersion &gt;= &quot;4.5.51209&quot; OR Net4x64FullVersion &gt;= &quot;4.5.51209&quot;))">
        <!-- Remote Payload: http://wixtoolset.org/documentation/manual/v3/xsd/wix/remotepayload.html -->
        <!-- StackOverflow Help: https://stackoverflow.com/questions/26850462/how-to-create-a-wix-exepackage-that-only-has-a-download-link -->
        <RemotePayload Description="Net45" Hash="89F86F9522DC7A8A965FACCE839ABB790A285A63" ProductName="Microsoft .NET Framework 4.5.2" Size="69999448" Version="4.5.51209.34209"/>
      </ExePackage>

      <ExePackage Id="Net4Full" Name="Microsoft .NET Framework 4.0 Setup" Cache="no" Compressed="no" PerMachine="yes" Permanent="yes" Vital="yes" InstallCommand="/q"
        DownloadUrl="https://download.microsoft.com/download/9/5/A/95A9616B-7A37-4AF6-BC36-D6EA96C8DAAE/dotNetFx40_Full_x86_x64.exe"
        DetectCondition="Net4FullVersion AND (NOT VersionNT64 OR Net4x64FullVersion)"
        InstallCondition="(VersionNT &lt; v6.0 OR VersionNT64 &lt; v6.0) AND (NOT (Net4FullVersion OR Net4x64FullVersion))">
        <RemotePayload Description="Net4Full" Hash="58da3d74db353aad03588cbb5cea8234166d8b99" ProductName="Microsoft .NET Framework 4 Setup" Version="4.0.30319.01" Size="50449456"/>
      </ExePackage>
        
      <!-- SQL Server Express 2014 w/SP2 to support Win7 and up-->
      <ExePackage Id="SQLExpress2014x64" Name="SQL Server 2014 With SP2" Cache="no" Compressed="no" PerMachine="yes" Permanent="yes" Vital="yes" InstallCommand="/q"
                  DownloadUrl="https://download.microsoft.com/download/2/A/5/2A5260C3-4143-47D8-9823-E91BB0121F94/SQLEXPR_x64_ENU.exe"
                  DetectCondition="SQL2014Expressx64"
                  InstallCondition="PROCESSOR_ARCHITECTURE=&quot;AMD64&quot;">
        <RemotePayload Description="SQLServer2014 Express SP2x64" Hash="34D7F2BBAF9452A41164156EC37B9A42F814390C" ProductName="Microsoft SQL Server Express SP2" Version="12.2.5000.0" Size="326871400"/>
      </ExePackage>
      
      <ExePackage Id="SQLExpress2014x86" Name="SQL Server 2014 With SP2" Cache="no" Compressed="no" PerMachine="yes" Permanent="yes" Vital="yes" InstallCommand="/q"
                  DownloadUrl="https://download.microsoft.com/download/2/A/5/2A5260C3-4143-47D8-9823-E91BB0121F94/SQLEXPR_x86_ENU.exe"
                  DetectCondition="SQL2014Expressx86"
                  InstallCondition="PROCESSOR_ARCHITECTURE=&quot;x86&quot;">
        <RemotePayload Description="SQLServer2014 Express SP2x86" Hash="43045A8A5163BAB7F103411C4D7F9BEB70BED225" ProductName="Microsoft SQL Server 2014 Express SP2" Version="12.2.5000.0" Size="287690248"/>
      </ExePackage>

      <RollbackBoundary Id="PreReqsMet" />
      
      <!-- Had to manually copy the MSI from the NineTapInstaller folder into the NineTapBootstrapper\Files folder-->
			<MsiPackage SourceFile="Files\9-TapTour.msi" />
      <MsiPackage SourceFile="Files\MemberImportInstaller.msi" />
		</Chain>
	</Bundle>
</Wix>

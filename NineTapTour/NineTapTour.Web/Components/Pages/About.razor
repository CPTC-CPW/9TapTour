@page "/about"

<PageTitle>About - 9-Tap Tour</PageTitle>

<PageHeader Title="About" />

<div class="row">
    <div class="col-md-8">
        <p>
            The 9-Tap Tour application keeps track of the 9-Tap Tour: member data,
            tournament information, games, monies earned, and player statistics.
        </p>
        <p>
            This website replaces the desktop application. Both share the same
            database and business rules, so tournaments entered here appear in the
            desktop app and vice versa.
        </p>
        <p class="text-muted">Version 4.0.0</p>
    </div>
    <div class="col-md-4 text-center">
        <img src="img/9taplogo1.png" alt="9-Tap Tour logo" class="img-fluid" style="max-width: 240px;" />
    </div>
</div>

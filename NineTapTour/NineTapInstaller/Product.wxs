<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define NineTapTour_TargetDir=$(var.NineTapTour.ProjectDir)bin\Release\?>
  <!-- Project References and variables 
      http://wixtoolset.org/documentation/manual/v3/votive/votive_project_references.html 
  -->
  <Product Id="*" Name="9-Tap Tour" Language="1033" Version="1.8.1" Manufacturer="Clover Park Technical College - Computer Programming" UpgradeCode="386d7054-e2db-458e-bd10-402ce9b04d30">
    <Package InstallerVersion="300" Compressed="yes" InstallScope="perMachine" />
    <Media Id="1" Cabinet="NineTapTour.cab" EmbedCab="yes" />

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="9-Tap Tour">
          <Directory Id="Resources" Name="Resources" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <!-- Add shortcuts and remove on uninstall -->
        <Directory Id="ApplicationProgramsFolder" Name="9-Tap Tour">
          <Component Id="ProgramMenuDir" Guid="127FBAF6-D916-4F99-9C12-7C959A48623D">
            <RemoveFolder Id="ProgramMenuDir" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\CPTC-CPW\9-TapTour"
                           Type="integer" Value="1" Name="installed" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Components to install -->
    <Feature Id="ProductFeature" Title="NineTapInstaller" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ResourceFiles"/>
      <ComponentRef Id="ProgramMenuDir"/>
    </Feature>
  
  
   <!-- Bootstrapper UI is now the default. These dialogs are ignored. -->   
  <UI>
    <!-- Resources -->
    <Binary Id="DialogBanner" SourceFile="Files\HorizontalBanner.bmp" />
    <Binary Id="InfoIcon" SourceFile="Files\Information.ico" />
    
    <!-- Fonts for dialogs -->
    <TextStyle Id="DlgFontSize10" FaceName="Tahoma" Size="10"/>
    <TextStyle Id="DlgTitleFont" FaceName="Tahoma" Size="12" Bold="yes"/>
   
    <!-- Properties to reference in Dialogs; Some point to Binary files by Id-->
    <Property Id="DefaultUIFont">DlgFontSize10</Property>
    <Property Id="BannerBitmap">DialogBanner</Property>
    <Property Id="WizardPrompt">9-Tap Tour Installation Wizard</Property>
    <Property Id="InfoIcon">InfoIcon</Property>
    <Property Id="LAUNCHPRODUCT">1</Property>
      
    <!--
      Dialog Help: https://www.firegiant.com/wix/tutorial/user-interface-revisited/interactions/ 
    -->
    <Dialog Id="InstallDialog" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
      <!-- Reference banner -->
      <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="[BannerBitmap]" />
      <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>The [WizardPrompt] is ready to begin</Text>
        </Control>
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
      <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
        <Text>{\DlgTitleFont}Ready to Install</Text>
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="CancelButton" Type="PushButton" X="304" Y="243" Width="54" Height="17" Cancel="yes" Text="Cancel">
        <Publish Event="SpawnDialog" Value="CancelDialog" />
      </Control>
      <Control Id="InstallButton" Type="PushButton" X="236" Y="243" Width="54" Height="17" Default="yes" Text="Install">
        <Publish Event="NewDialog" Value="ProgressDialog" />
      </Control>
    </Dialog>

    <Dialog Id="CancelDialog" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17"
        Default="yes" Cancel="yes" Text="No">
        <Publish Event="EndDialog" Value="Return">1</Publish>
      </Control>
      <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="Yes">
        <Publish Event="EndDialog" Value="Exit">1</Publish>
      </Control>
      <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30">
        <Text>Are you sure you want to cancel [ProductName] installation?</Text>
      </Control>
      <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24"
        ToolTip="Information icon" FixedSize="yes" IconSize="32" Text="[InfoIcon]" />
    </Dialog>

    <!-- Customize Installation Dialog: Not needed at this point? -->
    <!--
    <Dialog Id="CustomizeDialog" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes" TrackDiskSpace="yes">
      <Control Id="Tree" Type="SelectionTree" Disabled="no" X="25" Y="85" Width="175" Height="95"
        Property="_BrowseProperty" Sunken="yes" TabSkip="no" Text="Tree of selections" />
      <Control Id="Browse" Type="PushButton" X="304" Y="200" Width="56" Height="17" Text="Browse">
        <Publish Event="SelectionBrowse" Value="BrowseDialog">1</Publish>
      </Control>
      -->
    <!-- No reset button needed --><!--
      <Control Id="Reset" Type="PushButton" X="42" Y="243" Width="56" Height="17" Text="Reset">
        <Publish Event="Reset" Value="0">1</Publish>
        <Subscribe Event="SelectionNoItems" Attribute="Enabled" />
      </Control>-->
    <!--
      <Control Id="Box" Type="GroupBox" X="210" Y="81" Width="140" Height="98" />
      <Control Id="ItemDescription" Type="Text" X="215" Y="90" Width="131" Height="30">
        <Text>Multiline description of the currently selected item.</Text>
        <Subscribe Event="SelectionDescription" Attribute="Text" />
      </Control>
      <Control Id="ItemSize" Type="Text" X="215" Y="130" Width="131" Height="45">
        <Text>The size of the currently selected item.</Text>
        <Subscribe Event="SelectionSize" Attribute="Text" />
      </Control>
      <Control Id="Location" Type="Text" X="75" Y="200" Width="215" Height="20">
        <Text>The selections path</Text>
        <Subscribe Event="SelectionPath" Attribute="Text" />
        <Subscribe Event="SelectionPathOn" Attribute="Visible" />
      </Control>
      <Control Id="LocationLabel" Type="Text" X="25" Y="200" Width="50" Height="10" Text="Location:">
        <Subscribe Event="SelectionPathOn" Attribute="Visible" />
      </Control>
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
        <Publish Event="NewDialog" Value="InstallDialog">1</Publish>
        <Subscribe Event="SelectionNoItems" Attribute="Enabled" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
        <Publish Event="SpawnDialog" Value="CancelDialog">1</Publish>
      </Control>
    </Dialog>-->

    <!-- Browse Dialog: Not needed at this point-->
    <!--<Dialog Id="BrowseDialog" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="PathEdit" Type="PathEdit" X="84" Y="202" Width="261" Height="18" Property="_BrowseProperty" Indirect="yes" />
      <Control Id="OK" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Text="[ButtonText_OK]">
        <Publish Event="SetTargetPath" Value="[_BrowseProperty]">1</Publish>
        <Publish Event="EndDialog" Value="Return">1</Publish>
      </Control>
      <Control Id="Cancel" Type="PushButton" X="240" Y="243" Width="56" Height="17" Cancel="yes" Text="[ButtonText_Cancel]">
        <Publish Event="Reset" Value="0">1</Publish>
        <Publish Event="EndDialog" Value="Return">1</Publish>
      </Control>
      <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" TabSkip="no" Text="Look in:" />
      <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="220" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
        <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
      </Control>
      <Control Id="Up" Type="PushButton" X="298" Y="55" Width="19" Height="19" ToolTip="Up One Level" Icon="yes" FixedSize="yes" IconSize="16" Text="Up">
        <Publish Event="DirectoryListUp" Value="0">1</Publish>
      </Control>
      <Control Id="NewFolder" Type="PushButton" X="325" Y="55" Width="19" Height="19"
          ToolTip="Create A New Folder" Icon="yes" FixedSize="yes" IconSize="16" Text="New">
        <Publish Event="DirectoryListNew" Value="0">1</Publish>
      </Control>
      <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="110" Property="_BrowseProperty" Sunken="yes" Indirect="yes" TabSkip="no" />
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[ButtonText_Back]">
        <Publish Event="NewDialog" Value="CustomizeDialog">1</Publish>
      </Control>
    </Dialog>-->

    <!-- Installation Progress Dialog -->
    <Dialog Id="ProgressDialog" Width="370" Height="270" Title="[ProductName] Setup" Modeless="yes">
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
        <Publish Event="SpawnDialog" Value="CancelDialog">1</Publish>
      </Control>
      <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="[BannerBitmap]" />
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&lt; Back" />
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="Next &gt;" />
      <Control Id="ActionText" Type="Text" X="70" Y="100" Width="265" Height="10">
        <Subscribe Event="ActionText" Attribute="Text" />
      </Control>
      <Control Id="StatusLabel" Type="Text" X="35" Y="100" Width="35" Height="10" Text="Status:" />
      <Control Id="ProgressBar" Type="ProgressBar" X="35" Y="115" Width="300" Height="10" ProgressBlocks="yes" Text="Progress done">
        <Subscribe Event="SetProgress" Attribute="Progress" />
      </Control>
      <Control Id="ActionData" Type="Text" X="70" Y="200" Width="265" Height="30">
        <Subscribe Event="ActionData" Attribute="Text" />
      </Control>
    </Dialog>

    <!-- Finished Installation Dialog -->
    <Dialog Id="ExitDialog" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
        <Publish Event="EndDialog" Value="Return">1</Publish>
        <Publish Event='DoAction' Value='LaunchFile'>(NOT Installed) AND (LAUNCHPRODUCT = 1)</Publish>
      </Control>
      <Control Id="Launch" Type="CheckBox" X="135" Y="120" Width="150" Height="17" Property='LAUNCHPRODUCT' CheckBoxValue='1'>
        <Text>Launch [ProductName]</Text>
      </Control>
    </Dialog>
    
    <!-- Dialog Order -->
    <InstallUISequence>
      <!--<Show Dialog="CustomizeDialog" After="MigrateFeatureStates">Not Installed</Show>-->
      <Show Dialog="InstallDialog" After="CostFinalize" />
      <Show Dialog="ExitDialog" OnExit="success" />
    </InstallUISequence>
  </UI>

    <CustomAction Id='LaunchFile' FileKey='NineTapProg' ExeCommand='' Return="asyncNoWait" />
  </Product>

  <!-- Product Components-->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ProductTextFile">

        <!--Help https://stackoverflow.com/questions/14583509/wix-installer-start-menu-shortcut-not-appearing
        Start menu shortcut docs http://wixtoolset.org/documentation/manual/v3/howtos/files_and_registry/create_start_menu_shortcut.html -->
        <File Id="NineTapProg" Source ="$(var.NineTapTour_TargetDir)NineTapTour.exe">
          <Shortcut Id="desktopShortcut" Advertise="yes" Directory="DesktopFolder"
                    Name="9TapTour" WorkingDirectory="INSTALLFOLDER"
                    IconIndex="0" Icon="Icon1.ico">
            <Icon Id="Icon1.ico" SourceFile="Files\9tap.ico"/>
          </Shortcut>
          <Shortcut Id="startMenuShortcut" Directory="ApplicationProgramsFolder"
                    Name="9TapTour" WorkingDirectory="INSTALLFOLDER"
                    IconIndex="0" Advertise="yes" Icon="Icon2.ico">
            <Icon Id="Icon2.ico" SourceFile="Files\9tap.ico"/>
          </Shortcut>
        </File>      
      </Component>
      <Component Id="NineTapTour.exe.config" Guid="3f38b4ad-74de-4847-9555-f109bb4a821e">
        <File Id="NineTapTour.exe.config" Name="NineTapTour.exe.config" Source="$(var.NineTapTour_TargetDir)NineTapTour.exe.config" />
      </Component>
      <Component Id="EntityFramework.dll" Guid="01044c28-fbd3-4f01-bec0-c6af2a83eef7">
        <File Id="EntityFramework.dll" Name="EntityFramework.dll" Source="$(var.NineTapTour_TargetDir)EntityFramework.dll" />
      </Component>
      <Component Id="EntityFramework.SqlServer.dll" Guid="97de3945-2c70-4a5f-8ad2-67dd69f3240a">
        <File Id="EntityFramework.SqlServer.dll" Name="EntityFramework.SqlServer.dll" Source="$(var.NineTapTour_TargetDir)EntityFramework.SqlServer.dll" />
      </Component>
      <Component Id="FluentValidationNA.dll" Guid="4bcd2317-fc70-4778-945f-43552f575b24">
        <File Id="FluentValidationNA.dll" Name="FluentValidationNA.dll" Source="$(var.NineTapTour_TargetDir)FluentValidationNA.dll" />
      </Component>
      <Component Id="System.Linq.Dynamic.dll" Guid="c76f6d3a-a931-4631-afe9-5202aa420004">
        <File Id="System.Linq.Dynamic.dll" Name="System.Linq.Dynamic.dll" Source="$(var.NineTapTour_TargetDir)System.Linq.Dynamic.dll" />
      </Component>
      <Component Id="Icon_9tap.ico" Guid="2bc93db2-51f3-4366-98af-e128f7b12c34">
        <File Id="Icon_9tap.ico" Name="Ninetap.ico" Source="Files\9tap.ico" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="ResourceFiles" Directory="Resources">
      <Component Id="TournResultsTemplate" Guid="BFA36DC1-B45F-46B4-AA5A-C4C589DE655C">
        <File Id="TournResultsTemplate" Name="TournamentResultsTemplate.xls" Source="Resources\TournamentResultsTemplate.xls" />
      </Component>
      <Component Id="UserManual" Guid="51F0FB6F-F60E-46D6-906E-AF50E0B96001">
        <File Id="UserManual" Name="9TapUserManual.docx" Source="Resources\9TapUserManual.docx" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
